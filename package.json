{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-models-presets",
  "version": "0.3.2",
  "packageManager": "pnpm@10.34.5",
  "description": "Provider-agnostic OpenCode TUI plugin for assigning models, variants, and presets to agents.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist/",
    "examples/",
    "schemas/",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx tests/contracts.ts && node tests/validate-pr-title.test.mjs && node tests/release-policy.test.mjs && node tests/package-publication.test.mjs && node tests/publish-workflow.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:workflows": "node scripts/verify-workflow-actions.mjs",
    "security:audit": "pnpm audit --audit-level=low",
    "security:signatures": "node scripts/verify-registry-signatures.mjs",
    "security:check": "pnpm run security:audit && pnpm run security:signatures",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run verify:workflows && pnpm run verify:package"
  },
  "engines": {
    "node": "22.23.2",
    "opencode": ">=1.17.15 <2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.25",
    "@opentui/core": "0.5.9",
    "@opentui/keymap": "0.5.9",
    "@opentui/solid": "0.5.9",
    "@types/node": "26.4.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "solid-js": "1.9.15",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresnator/opencode-agent-model-configurator.git"
  },
  "bugs": {
    "url": "https://github.com/andresnator/opencode-agent-model-configurator/issues"
  },
  "homepage": "https://github.com/andresnator/opencode-agent-model-configurator#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "agents",
    "models",
    "presets",
    "variants"
  ]
}
